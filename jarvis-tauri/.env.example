# Copy this file to `.env` next to it, then paste real values. Anything missing
# from `.env` falls back to whatever the user entered in Settings → System
# Configuration (localStorage); the resolver in `src/elevenLabsConfig.ts`
# reads localStorage first, then this file, then graceful-degrades.
#
# Conventions:
#   - Vite builds any VITE_*-prefixed value into the renderer bundle (safe for
#     browser access; do NOT put anything here that needs to stay on the
#     backend only).
#   - Comments starting with `#` are ignored.
#   - Empty values are fine — the app will prompt in Settings to fill them,
#     and the voice/TTS layer has browser-native fallbacks when ElevenLabs is
#     unreachable or no key is set.

# ---------------------------------------------------------------
# Gemini REST API (chat + live voice replies)
# ---------------------------------------------------------------
# Without this, the AI service throws "no API key configured" when you try
# to chat. Free-tier keys from https://aistudio.google.com/apikey work.
VITE_GEMINI_API_KEY=

# ---------------------------------------------------------------
# ElevenLabs (TTS — the AI's spoken voice)
# ---------------------------------------------------------------
# Without this, the TTS layer falls back to the browser's native
# SpeechSynthesis so JARVIS is never silent. Optional but recommended
# for high-quality streaming voice.
# Get a key from: https://elevenlabs.io → Profile → API Keys
VITE_ELEVENLABS_API_KEY=

# Override the default voice (Bella/Rachel family). Leave blank for the
# default (EXAVITQu4vr4xnSDxMaL). Find IDs via the ElevenLabs Voice Library.
VITE_ELEVENLABS_VOICE_ID=

# Override the default model. Default is eleven_flash_v2_5 (low latency).
VITE_ELEVENLABS_MODEL_ID=

# ---------------------------------------------------------------
# Deepgram (STT fallback when browser SpeechRecognition fails)
# ---------------------------------------------------------------
# Without this, voice input falls back to the browser's Web Speech API.
# Recommended for production-grade accuracy.
# Get a key from: https://console.deepgram.com
VITE_DEEPGRAM_API_KEY=

# ---------------------------------------------------------------
# LiveKit (real-time voice pipeline)
# ---------------------------------------------------------------
# Used by the LiveKit agent entrypoint (`livekit_agent_v2.py`) and the
# Rust client in `src-tauri/audio/`. Self-hosted or LiveKit Cloud.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
