# ============================================================
# J.A.R.V.I.S. BACKEND ENVIRONMENT CONFIGURATION
# ============================================================

# WebSocket Server
WS_PORT=8000
MAX_SESSIONS=50

# =================================================================
# NVIDIA NIM Configuration
# =================================================================
# Get your API key from https://build.nvidia.com/
NIM_BASE_URL=https://integrate.api.nvidia.com
NIM_API_KEY=your_nvidia_api_key_here
NIM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# =================================================================
# Deepgram STT Configuration  
# =================================================================
# Get your API key from https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# =================================================================
# ElevenLabs TTS Configuration
# =================================================================
# Get your API key from https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=pNInz6oncaO5iEyIKttX

# =================================================================
# Gemini Configuration
# =================================================================
# Get your API key from https://aistudio.google.com/apikey
# Used by the renderer-side GeminiClient when localStorage is empty.
GEMINI_API_KEY=your_gemini_api_key_here
# Optional override; defaults to gemini-2.0-flash-lite if unset.
GEMINI_MODEL=gemini-2.0-flash-lite

# =================================================================
# LiveKit Configuration
# =================================================================
# Get credentials from https://cloud.livekit.io/
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# =================================================================
# Supabase Configuration
# =================================================================
# Get these from https://supabase.com/dashboard/project/<ref>/settings/api
SUPABASE_URL=your_project_ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://your_project_ref.supabase.co/auth/v1/.well-known/jwks.json
# =================================================================
# HTTP API Port (Supabase-authenticated endpoints)
# =================================================================
API_PORT=8080
