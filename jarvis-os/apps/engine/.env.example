# J.A.R.V.I.S. AI Engine Configuration

# PRIMARY: Groq API (Fastest - Recommended for voice conversations)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# FALLBACK: NVIDIA API (if Groq fails)
# NVIDIA_API_KEY=your_nvidia_key_here
# NVIDIA_MODEL=meta/llama-4-scout-17b-16e-instruct

# Optional: Legacy OpenAI (if you want fallback)
# OPENAI_API_KEY=your_openai_api_key_here
# DEFAULT_LLM_MODEL=gpt-4

# Memory configuration
MEMORY_DB_PATH=./data/jarvis_memory.db
VECTOR_STORE_PATH=./data/chroma_db

# Browser automation
PLAYWRIGHT_HEADLESS=false
BROWSER_TIMEOUT=30000

# Screenshot and vision
ENABLE_SCREENSHOTS=true
SCREENSHOT_QUALITY=80

# Server configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Security
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
