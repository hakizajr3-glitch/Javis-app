# Copy this file to .env next to it, then paste real values from
# /Users/innocekaiser/Documents/J.R.R.V.I.S/jarvis-tauri/.env if you want the
# two apps to share credentials.
#
# The Electron main process loads .env once at boot via `require('dotenv').config(...)`.
# Renderer code accesses values only through window.electronAPI.getConfig() — never
# import this file from React components.

# Gemini REST API key (used by geminiClient.js when localStorage is empty)
GEMINI_API_KEY=

# Deepgram — speech-to-text fallback when window.webkitSpeechRecognition fails
DEEPGRAM_API_KEY=

# ElevenLabs — text-to-speech for AI spoken responses
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# LiveKit — real-time voice pipeline (matches Tauri Rust setup)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
