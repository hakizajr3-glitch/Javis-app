{
  "name": "jarvis-electron",
  "version": "1.0.0",
  "description": "JARVIS Desktop",
  "main": "main.js",
  "scripts": {
    "dev": "node run-dev.js",
    "dev:renderer": "vite --port 5177 --host localhost",
    "build": "vite build",
    "pack:mac": "vite build && electron-builder --mac --dir",
    "dist:mac": "vite build && electron-builder --mac",
    "sign:mac": "codesign --sign - --force --deep --options runtime --entitlements entitlements.mac.plist --preserve-metadata=identifier,entitlements,flags release/mac-arm64/JARVIS.app",
    "start": "node scripts/patch-info-plist.js && electron ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.5",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "build": {
    "appId": "com.jarvis.desktop",
    "productName": "JARVIS",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "dist/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "identity": null,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "JARVIS uses the camera for visual input, motion detection, and avatar/vision features.",
        "NSMicrophoneUsageDescription": "JARVIS needs microphone access to hear your voice commands."
      }
    },
    "win": {
      "icon": "build/icon.ico",
      "target": ["appx", "nsis"]
    },
    "appx": {
      "identityName": "com.jarvis.desktop",
      "backgroundColor": "#0a0e14",
      "applicationId": "JARVIS",
      "displayName": "JARVIS"
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.5.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.0.0",
    "vite": "^5.4.0"
  }
}
